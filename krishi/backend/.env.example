# ============================================================
#  KISAN AI BACKEND — Environment Variables
#  Copy this → .env  and fill real values
# ============================================================

# Google Gemini API Key (free) → https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth Client ID → https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# JWT Secret for token signing (use a strong random string in production)
JWT_SECRET=your_jwt_secret_here

# OpenWeatherMap API Key (free) → https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# MongoDB Atlas Connection String → https://cloud.mongodb.com
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/krishiAi?retryWrites=true&w=majority

# Server port
PORT=25001

# Environment: development | production
NODE_ENV=development

# Frontend URL for CORS (optional, for separate frontend deployment)
FRONTEND_URL=https://your-frontend-url.vercel.app
